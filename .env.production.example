# Copy to .env.production. Do not commit the real file.
# DNS A/AAAA for APP_DOMAIN must point to the public VM.
APP_DOMAIN=kompak.example.com
ACME_EMAIL=admin@example.com

# Database is private to the compose network; never set localhost here.
# POSTGRES_PASSWORD and the password within DATABASE_URL MUST match.
# URL-encode reserved URL characters in DATABASE_URL's password.
POSTGRES_USER=kompak
POSTGRES_DB=kompak
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://kompak:REPLACE_WITH_LONG_RANDOM_PASSWORD@db:5432/kompak

# At least 32 random bytes each (e.g. openssl rand -hex 32). Use distinct values.
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_32_CHARS
EMAIL_CODE_SECRET=REPLACE_WITH_THIRD_RANDOM_SECRET_32_CHARS

# Same origin via reverse proxy (set by compose and build args).
CORS_ORIGIN=https://kompak.example.com
COOKIE_DOMAIN=

# Real outbound email provider (Mailpit must not be used in production).
SMTP_URL=smtps://SMTP_USER:SMTP_PASSWORD@smtp.example.com:465
MAIL_FROM="Kompak <no-reply@example.com>"

# Optional AI (leave blank to disable gracefully).
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_DAILY_BUDGET=12
